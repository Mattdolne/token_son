/* =========================================================================
   TEMA RETRÔ: TERMINAL DE FÓSFORO AZUL (IBM PC / BORLAND / NORTON COMMANDER)
   Design monocromático em tons de azul profundo e azul-claro fosforescente.
   ========================================================================= */

Screen {
    background: #040a14;
    color: #8cc8ff;
}

/* Barra Superior de Status (Header do Terminal) */
#top-status-bar {
    dock: top;
    height: 3;
    background: #081529;
    color: #99d6ff;
    border-bottom: solid #1f5c99;
    padding: 0 1;
    content-align: left middle;
    text-style: bold;
}

#top-status-bar.alerta-memoria {
    background: #1a2a4a;
    color: #00e5ff;
    border-bottom: double #3399ff;
}

/* Abas Principais de Navegação */
TabbedContent {
    height: 1fr;
    width: 100%;
    background: #040a14;
}

ContentSwitcher {
    height: 1fr;
    width: 100%;
}

Tabs {
    dock: top;
    background: #071120;
    color: #4d88cc;
    border-bottom: solid #1f5c99;
    height: 3;
}

Tab {
    padding: 0 2;
    color: #5c99e6;
    background: #071120;
}

Tab.-active {
    color: #040a14;
    background: #4da6ff;
    text-style: bold;
}

TabPane {
    height: 1fr;
    width: 100%;
    padding: 0 1;
    background: #040a14;
}

/* Colunas Lado a Lado */
.linha-dupla {
    layout: horizontal;
    height: 1fr;
    width: 100%;
}

.coluna-esq {
    width: 58%;
    height: 1fr;
    padding-right: 1;
}

.coluna-dir {
    width: 42%;
    height: 1fr;
    padding-left: 1;
}

.painel-retro {
    border: solid #1f5c99;
    background: #071120;
    padding: 0 1;
    margin-bottom: 1;
}

#painel-entrada {
    height: 33%;
}

#painel-preview {
    height: 34%;
}

#painel-saida {
    height: 33%;
}

#painel-destino {
    height: 38%;
}

#painel-tokens-modelo {
    height: 34%;
}

#painel-infra {
    height: 28%;
}

#painel-terminal-full {
    height: 1fr;
    width: 100%;
}

.titulo-painel {
    color: #4da6ff;
    text-style: bold;
    margin-bottom: 0;
}

/* Caixas de Texto (Prompt, Preview e Terminal Direto) */
TextArea {
    height: 1fr;
    border: solid #143d66;
    background: #02060d;
    color: #99d1ff;
}

TextArea:focus {
    border: solid #4da6ff;
}

/* Linha de Ações e Botões Retrô Azuis */
.linha-botoes {
    layout: horizontal;
    height: 3;
    align: left middle;
    margin-top: 0;
}

Button {
    background: #0a1c36;
    color: #8cc8ff;
    border: solid #266bb3;
    margin-right: 1;
    min-width: 14;
    height: 3;
}

Button:hover {
    background: #123059;
    color: #cce6ff;
    border: solid #4da6ff;
}

Button:focus {
    background: #4da6ff;
    color: #040a14;
    text-style: bold;
}

Button.-primary {
    background: #0d284d;
    color: #99d6ff;
    border: solid #3385ff;
}

Button.-success {
    background: #0b2e47;
    color: #66e0ff;
    border: solid #00b8e6;
}

Button.-error {
    background: #191838;
    color: #809fff;
    border: solid #3d5c99;
}

/* Banners de Informação e Notificação */
#banner-economia {
    height: 1;
    color: #33ccff;
    text-style: bold;
}

#caixa-docker, #caixa-k8s, #caixa-modelos-instalados, #caixa-catalogo {
    height: 1fr;
    overflow-y: auto;
    background: #02060d;
    border: solid #143d66;
    padding: 0 1;
    color: #8cc8ff;
}

/* Tabela e Seletores Retrô Azuis */
DataTable {
    background: #02060d;
    color: #8cc8ff;
    border: solid #143d66;
    height: 1fr;
}

DataTable > .datatable--header {
    background: #081529;
    color: #4da6ff;
    text-style: bold;
}

Select {
    background: #081529;
    color: #8cc8ff;
    border: solid #1f5c99;
}

SelectCurrent {
    background: #081529;
    color: #8cc8ff;
}

/* Terminal Interativo Manipulável Direto na Janela */
#janela-terminal-direta {
    height: 1fr;
    width: 100%;
    background: #02060d;
    border: solid #266bb3;
    color: #99d6ff;
}

#janela-terminal-direta:focus {
    border: double #4da6ff;
}

/* Barra de Progresso de Tokens */
ProgressBar {
    color: #4da6ff;
}

ProgressBar > .progressbar--bar {
    background: #143d66;
}

ProgressBar > .progressbar--complete {
    background: #3399ff;
}

/* Rodapé Retrô */
Footer {
    background: #071120;
    color: #5c99e6;
    border-top: solid #143d66;
}
